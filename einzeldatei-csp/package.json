{
  "name": "einzeldatei-csp",
  "private": true,
  "version": "0.0.1",
  "description": "Content-Security-Policy for an offline single-file web app: hashes of the inline scripts and styles, connect-src from a list of origins, a checker, and a Vite plugin. Build tool, no network.",
  "license": "AGPL-3.0-only",
  "author": "Tobias Heinrich",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.12"
  }
}
